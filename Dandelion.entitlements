<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime is on (see the build script). This one exception lets Dandelion ask
         Finder to move protected apps to the Trash; macOS still asks you once before allowing it. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
